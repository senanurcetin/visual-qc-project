# Copy to .env and edit. `docker compose up --build` reads it.
SECRET_KEY=change-me-to-a-long-random-string
# Use URL-safe characters (letters, digits, - _): it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=change-me-too
# Optional: enables /api/admin/corrections.csv (Authorization: Bearer <token>)
REVIEW_ADMIN_TOKEN=
# Optional: play a video instead of the simulator, e.g. video:/models/clip.mp4
FRAME_SOURCE=
# Optional abuse limits for the public write endpoints (defaults shown)
# REVIEW_MAX_PER_VISITOR=200   review decisions one visitor may store
# REVIEW_MAX_ROWS=50000        capacity of the review table (expired rows are pruned first)
# REVIEW_TTL_DAYS=90           retention of review decisions
# REVIEW_RATE_PER_MIN=30       POST /api/review requests per client per minute
# CLASSIFY_RATE_PER_MIN=20     POST /api/classify requests per client per minute
