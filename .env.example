# Copy to .env and edit. `docker compose up --build` reads it.
SECRET_KEY=change-me-to-a-long-random-string
# Use URL-safe characters (letters, digits, - _): it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=change-me-too
# Optional: enables /api/admin/corrections.csv (Authorization: Bearer <token>)
REVIEW_ADMIN_TOKEN=
# Optional: play a video instead of the simulator, e.g. video:/models/clip.mp4
FRAME_SOURCE=
